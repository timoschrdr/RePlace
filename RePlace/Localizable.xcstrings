    "Paused. The end time is for continuing right now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert. Die Endzeit gilt, wenn du jetzt fortsetzt."
          }
        }
      }
    },
    "Prefer motorways": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Autobahn bevorzugen"
          }
        }
