{
  "sourceLanguage": "en",
  "strings": {
    "Choose a device and a location.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Gerät und einen Ort."
          }
        }
      }
    },
    "No iPhone connected. Plug it in, unlock it and reload.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein iPhone verbunden. Anschließen, entsperren und neu laden."
          }
        }
      }
    },
    "Invalid coordinates. Format: 52.516275, 13.377704": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültige Koordinaten. Format: 52.516275, 13.377704"
          }
        }
      }
    },
    "Nothing found for “%@”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts gefunden für „%@“."
          }
        }
      }
    },
    "Search failed: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche fehlgeschlagen: %@"
          }
        }
      }
    },
    "Location set: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standort gesetzt: %@"
          }
        }
      }
    },
    "Simulation stopped. Your iPhone uses its real location again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulation beendet. Dein iPhone nutzt wieder den echten Standort."
          }
        }
      }
    },
    "unknown": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "unbekannt"
          }
        }
      }
    },
    "Error: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehler: %@"
          }
        }
      }
    },
    "Target": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel"
          }
        }
      }
    },
    "Device": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerät"
          }
        }
      }
    },
    "Reload devices": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräte neu laden"
          }
        }
      }
    },
    "Address": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse"
          }
        }
      }
    },
    "Search address or place": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse oder Ort suchen"
          }
        }
      }
    },
    "Coordinates": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koordinaten"
          }
        }
      }
    },
    "Or click on the map.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder auf die Karte klicken."
          }
        }
      }
    },
    "Set Location": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standort setzen"
          }
        }
      }
    },
    "Reset": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurücksetzen"
          }
        }
      }
    },
    "Favorites": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriten"
          }
        }
      }
    },
    "Save current location (name = search field)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuellen Ort speichern (Name = Suchfeld)"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen"
          }
        }
      }
    },
    "Help": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilfe"
          }
        }
      }
    },
    "Sets a simulated GPS location on your iPhone. It applies to the whole device, so every app sees it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt einen simulierten GPS-Standort auf deinem iPhone. Er gilt für das ganze Gerät, also sieht ihn jede App."
          }
        }
      }
    },
    "Connect your iPhone, unlock it and turn on Developer Mode.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone verbinden, entsperren und den Entwicklermodus einschalten."
          }
        }
      }
    },
    "Pick a place: click the map, search an address or paste coordinates.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ort wählen: auf die Karte klicken, Adresse suchen oder Koordinaten einfügen."
          }
        }
      }
    },
    "“Reset” brings back your real location. The simulation also ends when the connection is lost.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Zurücksetzen“ bringt den echten Standort zurück. Die Simulation endet auch, wenn die Verbindung getrennt wird."
          }
        }
      }
    },
    "Requires Xcode (uses Apple's devicectl). Only use this on your own devices and in line with the terms of the apps you use.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benötigt Xcode (nutzt Apples devicectl). Nur auf eigenen Geräten und im Rahmen der Nutzungsbedingungen der verwendeten Apps einsetzen."
          }
        }
      }
    },
    "Mode": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modus"
          }
        }
      }
    },
    "Point": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Punkt"
          }
        }
      }
    },
    "Route": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Route"
          }
        }
      }
    },
    "Clear": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leeren"
          }
        }
      }
    },
    "Click the map or pick a place to add waypoints. The iPhone moves along them in order and stops at the last one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf die Karte oder wähle einen Ort, um Wegpunkte zu setzen. Das iPhone bewegt sich der Reihe nach daran entlang und bleibt am letzten stehen."
          }
        }
      }
    },
    "Follow roads": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Straßen folgen"
          }
        }
      }
    },
    "Speed: %lld km/h": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo: %lld km/h"
          }
        }
      }
    },
    "Calculating route…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Route wird berechnet …"
          }
        }
      }
    },
    "Start Route": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Route starten"
          }
        }
      }
    },
    "Could not calculate roads. Using straight lines instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Straßen konnten nicht berechnet werden. Stattdessen gerade Linien."
          }
        }
      }
    },
    "Route finished. Your iPhone stays at the end point.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Route beendet. Dein iPhone bleibt am Endpunkt stehen."
          }
        }
      }
    },
    "Press “Set Location”. For a moving route, switch to “Route”, add waypoints and press “Start Route”. “Pause” stops where you are, “Continue” goes on from there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Standort setzen“ drücken. Für eine bewegte Route auf „Route“ wechseln, Wegpunkte setzen und „Route starten“ drücken. „Pause“ hält an, „Fortsetzen“ geht von dort aus weiter."
          }
        }
      }
    },
    "Pause": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsetzen"
          }
        }
      }
    },
    "Route paused. Your iPhone stays at the last position.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Route pausiert. Dein iPhone bleibt an der letzten Position."
          }
        }
      }
    },
    "Moving along the route: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterwegs auf der Route: %@"
          }
        }
      }
    },
    "App Icon": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Symbol"
          }
        }
      }
    },
    "Pin": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadel"
          }
        }
      }
    },
    "Raccoon": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Waschbär"
          }
        }
      }
    },
    "Changes the icon in the Dock while RePlace. is running. The icon in Finder and in the Applications folder stays the same.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert das Symbol im Dock, solange RePlace. läuft. Das Symbol im Finder und im Programme-Ordner bleibt gleich."
          }
        }
      }
    },
    "Grey Raccoon": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grauer Waschbär"
          }
        }
      }
    },
    "Location set": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standort gesetzt"
          }
        }
      }
    },
    "Start": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Start"
          }
        }
      }
    },
    "Start (now)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Start (jetzt)"
          }
        }
      }
    },
    "End": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ende"
          }
        }
      }
    },
    "End (estimated)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ende (geschätzt)"
          }
        }
      }
    },
    "Paused. The end time is for continuing right now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert. Die Endzeit gilt, wenn du jetzt fortsetzt."
          }
        }
      }
    }
  },
  "version": "1.0"
}