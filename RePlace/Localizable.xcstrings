    "Lost the connection to your iPhone. The simulation may still be active on it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung zu deinem iPhone ist abgebrochen. Die Simulation ist womöglich noch aktiv."
